{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lugu.love/schemas/music-catalog-v1.json",
  "title": "Lugu Love Music Catalog V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "catalogVersion",
    "updatedAt",
    "assetBaseUrl",
    "tracks"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "catalogVersion": {
      "type": "string",
      "pattern": "^[0-9]{8}-[0-9]{2}$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "assetBaseUrl": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "tracks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/track"
      }
    }
  },
  "$defs": {
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "file",
        "url",
        "duration",
        "mood",
        "source",
        "license",
        "status",
        "classification",
        "statusReason",
        "contexts",
        "provider",
        "visibility",
        "mimeType",
        "bytes",
        "sha256",
        "version",
        "artwork",
        "preview"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^music\\.[a-z0-9.-]+\\.[0-9]{3}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "file": {
          "type": "string",
          "pattern": "^(audio|previews)/v1/"
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "duration": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "mood": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "license": {
          "$ref": "#/$defs/license"
        },
        "status": {
          "enum": [
            "draft",
            "active",
            "archived",
            "blocked"
          ]
        },
        "classification": {
          "enum": [
            "legacy",
            "candidate",
            "commissioned",
            "partner",
            "user"
          ]
        },
        "statusReason": {
          "type": [
            "string",
            "null"
          ]
        },
        "contexts": {
          "$ref": "#/$defs/contexts"
        },
        "provider": {
          "$ref": "#/$defs/provider"
        },
        "visibility": {
          "enum": [
            "public",
            "unlisted",
            "private"
          ]
        },
        "mimeType": {
          "enum": [
            "audio/mp4",
            "audio/mpeg",
            "audio/wav"
          ]
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "artwork": {
          "type": [
            "string",
            "null"
          ]
        },
        "preview": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "provider",
        "providerTrackId",
        "sourceUrl",
        "acquiredAt",
        "notes"
      ],
      "properties": {
        "type": {
          "enum": [
            "local-archive",
            "external-provider",
            "commissioned",
            "partner",
            "user"
          ]
        },
        "provider": {
          "type": [
            "string",
            "null"
          ]
        },
        "providerTrackId": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourceUrl": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "acquiredAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "type",
        "licenseProof",
        "commercialUse",
        "attributionRequired",
        "attributionText",
        "expiresAt",
        "territory"
      ],
      "properties": {
        "status": {
          "enum": [
            "verified",
            "unverified",
            "restricted",
            "unknown"
          ]
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "licenseProof": {
          "type": [
            "string",
            "null"
          ]
        },
        "commercialUse": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "attributionRequired": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "attributionText": {
          "type": [
            "string",
            "null"
          ]
        },
        "expiresAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "territory": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "contexts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "earthRandom",
        "bottleRandom",
        "activeSend",
        "opening"
      ],
      "properties": {
        "earthRandom": {
          "type": "boolean"
        },
        "bottleRandom": {
          "type": "boolean"
        },
        "activeSend": {
          "type": "boolean"
        },
        "opening": {
          "type": "boolean"
        }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "enum": [
            "internal",
            "partner",
            "user",
            "external"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
