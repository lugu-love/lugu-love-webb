# Windows 本地媒体引擎环境变量示例
# 复制为 .env 后可留作配置参考；当前 start-windows.cmd / verify-windows.cmd
# 不自动读取 .env，而是使用内置安全默认值并优先调用系统 PATH 中的命令。
# 禁止在此文件或 .env 中写入真实 API Key、数据库地址、密码或 Token。

# 服务端口（绑定地址由 start-windows.cmd 固定为 127.0.0.1）
PORT=8000

# FFmpeg：留空表示使用 PATH 中的 ffmpeg
FFMPEG_BIN=

# 中文字体：留空表示由脚本自动检测 Windows 系统字体
FONT_FILE=
FONT_INDEX=0
FONT_FC=

# 本地 TTS 与站点状态
TTS_PROVIDER=edge-tts
TTS_VOICE=zh-CN-XiaoxiaoNeural
SERVICE_ENABLED=true
SITE_STATE_FILE=
PUBLIC_BASE_URL=http://127.0.0.1:8000

# 临时目录（默认落在本目录 tmp\ 下，已被 .gitignore 忽略）
# APP_VIDEO_DIR=
# TTS_CACHE_DIR=

# ===== 外部服务相关，禁止填写真实值 =====
# ELEVENLABS_API_KEY=
# ADMIN_PASSWORD_HASH=
# DATABASE_URL=
# JOURNEY_DATABASE_URL=
